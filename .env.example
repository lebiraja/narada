# Postgres
POSTGRES_USER=band
POSTGRES_PASSWORD=change-me
POSTGRES_DB=band
DATABASE_URL=postgresql+asyncpg://band:change-me@postgres:5432/band

# Redis
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=change-me

# LLM provider (any OpenAI-compatible endpoint)
# Anthropic:
#   LLM_BASE_URL=https://api.anthropic.com/v1
#   LLM_MODEL_LEADER=claude-opus-5
#   LLM_MODEL_PLAYER=claude-haiku-4-5-20251001
# Groq (fast and cheap; good for the per-bar players):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL_LEADER=openai/gpt-oss-120b
#   LLM_MODEL_PLAYER=openai/gpt-oss-20b
# Local Ollama:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_LEADER=openai/gpt-oss-120b
LLM_MODEL_PLAYER=openai/gpt-oss-20b

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# How many players may call the model at once (lower for tight TPM budgets)
LLM_MAX_CONCURRENCY=5

# Reasoning budget: "low" keeps per-bar players fast and cheap.
# Leave blank for providers that do not accept the parameter.
LLM_PLAYER_EFFORT=low
LLM_LEADER_EFFORT=
